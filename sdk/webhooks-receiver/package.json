{
  "name": "@invoica/webhooks-receiver",
  "version": "0.1.0",
  "description": "Typed Invoica webhook receiver — HMAC verification + discriminated-union event types + optional Express middleware.",
  "license": "Apache-2.0",
  "author": "Invoica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skingem/Invoica.git",
    "directory": "sdk/webhooks-receiver"
  },
  "keywords": [
    "invoica",
    "webhooks",
    "hmac",
    "pact",
    "mandate",
    "x402",
    "agents"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.10.0",
    "express": "^5.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
