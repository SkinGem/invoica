{
  "section_id": "create_invoice",
  "version": "0.1",
  "description": "Create a machine-payable invoice via x402 micro-payment. The caller pays 0.01 USDC on Solana; Invoica mints a PENDING invoice record and returns its id.",
  "tools": [
    {
      "name": "invoica_create_invoice",
      "description": "Create an invoice via x402 payment (0.01 USDC). Returns the new invoice record.",
      "endpoint": "https://api.invoica.ai/api/x402/invoice",
      "method": "POST",
      "auth": "x402",
      "x402_price_usdc": "0.01",
      "input_schema": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "description": "Seller name or agent id"
          },
          "recipient": {
            "type": "string",
            "description": "Buyer name or agent id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Buyer email (auto-generated if omitted)"
          },
          "amount": {
            "type": "number",
            "description": "Invoice amount in chosen currency",
            "default": 0.01
          },
          "currency": {
            "type": "string",
            "default": "USDC"
          },
          "description": {
            "type": "string",
            "description": "Service description"
          }
        },
        "required": []
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "capability": {
            "type": "string",
            "enum": [
              "invoice"
            ]
          },
          "result": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "invoiceNumber": {
                "type": "integer"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "PAID",
                  "SETTLED",
                  "CANCELLED"
                ]
              },
              "amount": {
                "type": "number"
              },
              "currency": {
                "type": "string"
              },
              "sellerName": {
                "type": "string"
              },
              "customerName": {
                "type": "string"
              },
              "customerEmail": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "invoiceNumber",
              "status",
              "amount",
              "currency"
            ]
          }
        },
        "required": [
          "success",
          "capability",
          "result"
        ]
      }
    }
  ],
  "examples": [
    {
      "description": "Create a $5 USDC invoice for API consulting",
      "request": {
        "issuer": "agent-gpt-4o",
        "recipient": "client-company",
        "amount": 5,
        "currency": "USDC",
        "description": "API consulting 2026-06"
      },
      "response": {
        "success": true,
        "capability": "invoice",
        "result": {
          "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "invoiceNumber": 1748736000,
          "status": "PENDING",
          "amount": 5,
          "currency": "USDC",
          "sellerName": "agent-gpt-4o",
          "customerName": "client-company",
          "customerEmail": "x402-payer@x402.invoica.ai",
          "createdAt": "2026-06-01T12:00:00.000Z",
          "updatedAt": "2026-06-01T12:00:00.000Z"
        }
      }
    }
  ]
}