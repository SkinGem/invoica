{
  "section_id": "create_invoice",
  "version": "0.1.0",
  "description": "Create a new invoice for goods or services. Supports both immediate payment and mandate-based recurring billing.",
  "tools": [
    {
      "name": "invoica_create_invoice",
      "description": "Create a new invoice with line items, customer details, and payment terms",
      "input_schema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Customer name or business name"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Customer email address for invoice delivery"
              },
              "address": {
                "type": "object",
                "properties": {
                  "line1": {
                    "type": "string",
                    "description": "Street address line 1"
                  },
                  "line2": {
                    "type": "string",
                    "description": "Street address line 2 (optional)"
                  },
                  "city": {
                    "type": "string",
                    "description": "City"
                  },
                  "state": {
                    "type": "string",
                    "description": "State or province"
                  },
                  "postal_code": {
                    "type": "string",
                    "description": "ZIP or postal code"
                  },
                  "country": {
                    "type": "string",
                    "description": "Country code (ISO 3166-1 alpha-2)"
                  }
                },
                "required": ["line1", "city", "country"],
                "additionalProperties": false
              }
            },
            "required": ["name", "email"],
            "additionalProperties": false
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "description": "Description of the item or service"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0.01,
                  "description": "Quantity of items"
                },
                "unit_price": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Price per unit in USD cents"
                },
                "tax_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Tax rate as decimal (0.08 = 8%)"
                }
              },
              "required": ["description", "quantity", "unit_price"],
              "additionalProperties": false
            },
            "minItems": 1,
            "description": "Array of invoice line items"
          },
          "payment_terms": {
            "type": "object",
            "properties": {
              "due_date": {
                "type": "string",
                "format": "date",
                "description": "Payment due date (ISO 8601 date)"
              },
              "payment_method": {
                "type": "string",
                "enum": ["immediate", "mandate"],
                "description": "Payment collection method"
              },
              "mandate_id": {
                "type": "string",
                "description": "Required if payment_method is 'mandate'. Reference to existing payment mandate."
              }
            },
            "required": ["due_date", "payment_method"],
            "additionalProperties": false
          },
          "notes": {
            "type": "string",
            "description": "Additional notes or terms to include on the invoice"
          },
          "reference": {
            "type": "string",
            "description": "External reference number or identifier"
          }
        },
        "required": ["customer", "line_items", "payment_terms"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "Unique invoice identifier"
          },
          "invoice_number": {
            "type": "string",
            "description": "Sequential invoice number (e.g., INV-2024-001)"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "sent", "paid", "overdue", "cancelled"],
            "description": "Current invoice status"
          },
          "total_amount": {
            "type": "number",
            "description": "Total invoice amount in USD cents including tax"
          },
          "subtotal": {
            "type": "number",
            "description": "Subtotal before tax in USD cents"
          },
          "tax_amount": {
            "type": "number",
            "description": "Total tax amount in USD cents"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Invoice creation timestamp (ISO 8601)"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Payment due date"
          },
          "pdf_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to download PDF version of invoice"
          },
          "payment_url": {
            "type": "string",
            "format": "uri",
            "description": "URL for customer to make payment (if immediate payment method)"
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            },
            "required": ["name", "email"],
            "additionalProperties": false
          }
        },
        "required": ["invoice_id", "invoice_number", "status", "total_amount", "subtotal", "tax_amount", "created_at", "due_date", "customer"],
        "additionalProperties": false
      }
    }
  ],
  "examples": [
    {
      "name": "Simple service invoice",
      "description": "Create an invoice for consulting services with immediate payment",
      "input": {
        "customer": {
          "name": "Acme Corporation",
          "email": "billing@acme.com",
          "address": {
            "line1": "123 Business St",
            "city": "San Francisco",
            "state": "CA",
            "postal_code": "94105",
            "country": "US"
          }
        },
        "line_items": [
          {
            "description": "Software consulting services",
            "quantity": 40,
            "unit_price": 15000,
            "tax_rate": 0.08
          }
        ],
        "payment_terms": {
          "due_date": "2024-02-15",
          "payment_method": "immediate"
        },
        "notes": "Payment due within 30 days of invoice date.",
        "reference": "PO-2024-001"
      },
      "output": {
        "invoice_id": "inv_1234567890abcdef",
        "invoice_number": "INV-2024-001",
        "status": "pending",
        "total_amount": 648000,
        "subtotal": 600000,
        "tax_amount": 48000,
        "created_at": "2024-01-16T10:30:00Z",
        "due_date": "2024-02-15",
        "pdf_url": "https://invoica.ai/invoices/inv_1234567890abcdef/pdf",
        "payment_url": "https://invoica.ai/pay/inv_1234567890abcdef",
        "customer": {
          "name": "Acme Corporation",
          "email": "billing@acme.com"
        }
      }
    },
    {
      "name": "Recurring subscription invoice",
      "description": "Create an invoice for monthly subscription using existing mandate",
      "input": {
        "customer": {
          "name": "StartupXYZ Inc",
          "email": "finance@startupxyz.com"
        },
        "line_items": [
          {
            "description": "Monthly SaaS subscription - Pro Plan",
            "quantity": 1,
            "unit_price": 9900,
            "tax_rate": 0.0875
          }
        ],
        "payment_terms": {
          "due_date": "2024-02-01",
          "payment_method": "mandate",
          "mandate_id": "mdt_abc123def456"
        },
        "reference": "SUB-PRO-202401"
      },
      "output": {
        "invoice_id": "inv_fedcba0987654321",
        "invoice_number": "INV-2024-002",
        "status": "pending",
        "total_amount": 10767,
        "subtotal": 9900,
        "tax_amount": 867,
        "created_at": "2024-01-16T11:15:00Z",
        "due_date": "2024-02-01",
        "pdf_url": "https://invoica.ai/invoices/inv_fedcba0987654321/pdf",
        "customer": {
          "name": "StartupXYZ Inc",
          "email": "finance@startupxyz.com"
        }
      }
    },
    {
      "name": "Multi-item product invoice",
      "description": "Create an invoice with multiple products and different tax rates",
      "input": {
        "customer": {
          "name": "Jane Smith",
          "email": "jane@example.com",
          "address": {
            "line1": "456 Oak Avenue",
            "line2": "Apt 2B",
            "city": "Portland",
            "state": "OR",
            "postal_code": "97205",
            "country": "US"
          }
        },
        "line_items": [
          {
            "description": "Premium Widget",
            "quantity": 2,
            "unit_price": 2500,
            "tax_rate": 0.0875
          },
          {
            "description": "Standard Widget",
            "quantity": 5,
            "unit_price": 1200,
            "tax_rate": 0.0875
          },
          {
            "description": "Installation Service",
            "quantity": 1,
            "unit_price": 5000,
            "tax_rate": 0.0875
          }
        ],
        "payment_terms": {
          "due_date": "2024-02-20",
          "payment_method": "immediate"
        },
        "notes": "Installation scheduled for February 10th, 2024."
      },
      "output": {
        "invoice_id": "inv_9876543210fedcba",
        "invoice_number": "INV-2024-003",
        "status": "pending",
        "total_amount": 16437,
        "subtotal": 15000,
        "tax_amount": 1437,
        "created_at": "2024-01-16T14:22:00Z",
        "due_date": "2024-02-20",
        "pdf_url": "https://invoica.ai/invoices/inv_9876543210fedcba/pdf",
        "payment_url": "https://invoica.ai/pay/inv_9876543210fedcba",
        "customer": {
          "name": "Jane Smith",
          "email": "jane@example.com"
        }
      }
    }
  ]
}