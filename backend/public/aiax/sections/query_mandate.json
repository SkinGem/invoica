{
  "section_id": "query_mandate",
  "version": "0.1",
  "description": "Query the public redacted view of a PACT mandate by its id. No authentication required. Returns state, hashes, and party names only.",
  "tools": [
    {
      "name": "invoica_query_mandate",
      "description": "Fetch the public redacted view of a mandate (no auth). Returns state, mandate_hash, anchor_tx_hash, created_at, and party names/roles.",
      "endpoint": "https://api.invoica.ai/v1/public/mandates/{mandate_id}",
      "method": "GET",
      "auth": "none",
      "input_schema": {
        "type": "object",
        "properties": {
          "mandate_id": {
            "type": "string",
            "description": "Mandate UUID (path parameter)"
          }
        },
        "required": [
          "mandate_id"
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "signed_by_proposer",
              "signed_by_both",
              "in_progress",
              "completed",
              "disputed",
              "expired",
              "cancelled"
            ]
          },
          "mandate_hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "PACT mandate content hash"
          },
          "anchor_tx_hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "On-chain anchor transaction hash (Base Sepolia)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "parties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "proposer",
                    "counterparty"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "name"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "state",
          "created_at",
          "parties"
        ]
      }
    }
  ],
  "examples": [
    {
      "description": "Query a signed mandate",
      "request": {
        "mandate_id": "m9x8y7z6-a1b2-c3d4-e5f6-789012345678"
      },
      "response": {
        "id": "m9x8y7z6-a1b2-c3d4-e5f6-789012345678",
        "state": "signed_by_both",
        "mandate_hash": "0xabc123def456789abc123def456789abc123def456789abc123def456789abcd12",
        "anchor_tx_hash": "0x55acdef1234567890abcdef1234567890abcdef1234567890abcdef1234c497",
        "created_at": "2026-05-28T10:00:00.000Z",
        "parties": [
          {
            "role": "proposer",
            "name": "helixa-synagent"
          },
          {
            "role": "counterparty",
            "name": "invoica-core"
          }
        ]
      }
    }
  ]
}