{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Invoica",
  "logo": {
    "dark": "/logo/logo-dark.png",
    "light": "/logo/logo.png"
  },
  "favicon": "/logo/logo.png",
  "colors": {
    "primary": "#635BFF",
    "light": "#818CF8",
    "dark": "#635BFF"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.invoica.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API Key",
      "href": "https://app.invoica.ai/api-keys"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/x402-protocol",
              "concepts/invoice-middleware",
              "concepts/pact"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/create-invoice",
              "guides/webhooks",
              "guides/tax-compliance"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "api-reference/overview",
          "api-reference/invoices",
          "api-reference/settlements",
          "api-reference/webhooks"
        ]
      },
      {
        "tab": "SDK",
        "pages": [
          "sdk/overview",
          "sdk/installation"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Status",
          "icon": "signal-bars",
          "href": "https://invoica.ai/status"
        },
        {
          "anchor": "Support",
          "icon": "envelope",
          "href": "mailto:support@invoica.ai"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "twitter": "https://twitter.com/NexusCollectv"
    }
  }
}
